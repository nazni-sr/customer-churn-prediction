# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env

# Jupyter
.ipynb_checkpoints/

# Data (raw datasets can be large / shouldn't be committed)
data/raw/*
!data/raw/.gitkeep
*.csv
!data/sample/*.csv

# Model artifacts (best_model.joblib is committed deliberately: the deployed
# Streamlit app needs it in the repo, since Streamlit Cloud does a fresh git
# clone rather than re-running the training notebooks)
*.pkl
*.joblib
!models/best_model.joblib
models/*.pkl

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Distribution / packaging
build/
dist/
*.egg-info/
